Vagrant.configure("2") do |config|
  config.vm.box = "debian/bookworm64"
  config.vm.synced_folder ".", "/vagrant", disabled: true

  config.vm.define "dev" do |dev|
    dev.vm.hostname = "dev"
    dev.vm.network "private_network",
      ip: "192.168.56.10",
      libvirt__network_name: "lesson12",
      libvirt__host_ip: "192.168.56.1",
      libvirt__dhcp_enabled: false,
      libvirt__forward_mode: "nat",
      libvirt__netmask: "255.255.255.0"
  end

  config.vm.define "prod" do |prod|
    prod.vm.hostname = "prod"
    prod.vm.network "private_network",
      ip: "192.168.56.11",
      libvirt__network_name: "lesson12",
      libvirt__host_ip: "192.168.56.1",
      libvirt__dhcp_enabled: false,
      libvirt__forward_mode: "nat",
      libvirt__netmask: "255.255.255.0"
  end
end
[defaults]
inventory = env/dev/inventory
host_key_checking = False
remote_user = vagrant
[dev]
dev ansible_host=192.168.56.10 ansible_user=vagrant ansible_ssh_private_key_file=../.vagrant/machines/dev/libvirt/private_key
[prod]
prod ansible_host=192.168.56.11 ansible_user=vagrant ansible_ssh_private_key_file=../.vagrant/machines/prod/libvirt/private_key
---
- name: Configure hosts
  hosts: all
  become: true

  tasks:
    - name: Install packages
      ansible.builtin.apt:
        name:
          - wget
          - htop
          - nginx
        state: present
        update_cache: true

    - name: Start nginx
      ansible.builtin.service:
        name: nginx
        state: started
        enabled: true

    - name: Show environment
      ansible.builtin.debug:
        msg: "This host is in {{ group_names[0] }} environment"
