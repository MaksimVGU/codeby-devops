<VirtualHost *:80>
    ServerName {{ wordpress_domain }}
    DocumentRoot {{ wordpress_install_dir }}

    <Directory {{ wordpress_install_dir }}>
        AllowOverride All
        Require all granted
    </Directory>

    DirectoryIndex index.php index.html

    ErrorLog {{ '/var/log/apache2/wordpress_error.log' if ansible_facts.os_family == 'Debian' else '/var/log/httpd/wordpress_error.log' }}
    CustomLog {{ '/var/log/apache2/wordpress_access.log' if ansible_facts.os_family == 'Debian' else '/var/log/httpd/wordpress_access.log' }} combined
</VirtualHost>
